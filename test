cmake_minimum_required(VERSION 3.10)
project(st7789_tft_py)

find_package(pybind11 REQUIRED)  # Tìm pybind11

add_library(rpist7789gl STATIC src/st7789/ST7789_TFT.cpp src/st7789/ST7789_TFT_Print.cpp src/st7789/ST7789_TFT_graphics.cpp src/st7789/ST7789_TFT_font.cpp)  # Nếu cần build lib từ source (nếu make install chưa)

pybind11_add_module(st7789_tft st7789_binding.cpp)  # Tạo module từ binding.cpp

target_include_directories(st7789_tft PRIVATE 
    include/st7789  # Điều chỉnh path header
    /usr/local/include  # Cho bcm2835
)

target_link_libraries(st7789_tft PRIVATE 
    rpist7789gl  # Nếu bạn add_library ở trên, hoặc tên lib sau make install (thường librpist7789gl.so hoặc ST7789_TFT)
    bcm2835
)
