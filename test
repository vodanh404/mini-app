#include <pybind11/pybind11.h>
#include "ST7789_TFT_LCD_RVL.hpp"  // Header chính
#include "color16_graphics_RVL.hpp" // Nếu có graphics methods
#include "print_data_RVL.hpp"       // Nếu có print/setFont

namespace py = pybind11;

PYBIND11_MODULE(st7789_tft, m) {
    m.doc() = "Python bindings for ST7789_TFT_RPI library";

    py::class_<ST7789_TFT>(m, "ST7789_TFT")
        .def(py::init<>(), "Default constructor")

        // Các method init (có trong repo, nhưng có thể cần gọi đúng thứ tự)
        .def("SetupGPIO", &ST7789_TFT::SetupGPIO, "Cấu hình GPIO")
        .def("InitSPI", &ST7789_TFT::InitSPI, py::arg("speed"), py::arg("ce_pin"), py::arg("delay"), "Khởi tạo SPI")
        .def("InitScreenSize", &ST7789_TFT::InitScreenSize, py::arg("width"), py::arg("height"), py::arg("x_offset"), py::arg("y_offset"), "Set kích thước")
        .def("InitScreen", &ST7789_TFT::InitScreen, "Gửi lệnh init cho chip ST7789")

        // Graphics (từ color16_graphics_RVL hoặc inherited)
        .def("fillScreen", &ST7789_TFT::fillScreen, py::arg("color"), "Tô toàn màn hình")
        .def("drawPixel", &ST7789_TFT::drawPixel, py::arg("x"), py::arg("y"), py::arg("color"), "Vẽ pixel")

        // Text (từ print_data_RVL)
        .def("setFont", &ST7789_TFT::setFont, py::arg("font_number"), "Chọn font")
        .def("print", py::overload_cast<const char*, int16_t, int16_t>(&ST7789_TFT::print), py::arg("text"), py::arg("x"), py::arg("y"), "In text")  // Nếu có overload này

        // Các method từ grep của bạn
        .def("TFTsetRotation", &ST7789_TFT::TFTsetRotation, py::arg("r"), "Xoay màn hình")
        .def("TFTchangeInvertMode", &ST7789_TFT::TFTchangeInvertMode, py::arg("m"), "Đảo màu")
        .def("TFTsleepDisplay", &ST7789_TFT::TFTsleepDisplay, py::arg("m"), "Chế độ sleep")
        ;

    // Enum rotation (dựa trên TFT_rotate_e trong header)
    py::enum_<TFT_rotate_e>(m, "TFT_rotate_e")
        .value("TFT_ROTATE_0", TFT_ROTATE_0)   // Giả sử enum này tồn tại, thay bằng giá trị thực nếu khác
        .value("TFT_ROTATE_90", TFT_ROTATE_90)
        .value("TFT_ROTATE_180", TFT_ROTATE_180)
        .value("TFT_ROTATE_270", TFT_ROTATE_270)
        .export_values();
}
