#include <pybind11/pybind11.h>
#include "ST7789_TFT_LCD_RVL.hpp"  // Header chính

namespace py = pybind11;

PYBIND11_MODULE(st7789_tft, m) {
    m.doc() = "Python bindings for ST7789_TFT_RPI library";

    py::class_<ST7789_TFT>(m, "ST7789_TFT")
        // Constructors
        .def(py::init<uint8_t, uint8_t>(), py::arg("dc_pin"), py::arg("rst_pin"), "Constructor with DC and RESET pins")
        .def(py::init<>(), "Default constructor")

        // Initialization
        .def("SetupGPIO", py::overload_cast<>(&ST7789_TFT::SetupGPIO), "Setup GPIO for default HW SPI")
        .def("InitSPI", &ST7789_TFT::InitSPI, py::arg("channel"), py::arg("speed"), py::arg("ce_pin"), "Init hardware SPI (channel 0/1, speed Hz, CE 0/1)")
        .def("InitScreenSize", &ST7789_TFT::InitScreenSize, py::arg("width"), py::arg("height"), py::arg("x_offset") = 0, py::arg("y_offset") = 0, "Set display size and offset")
        .def("InitScreen", &ST7789_TFT::InitScreen, "Send init commands to ST7789 chip (must call after size/SPI)")

        // Graphics
        .def("fillScreen", &ST7789_TFT::fillScreen, py::arg("color"), "Fill entire screen with RGB565 color")
        .def("drawPixel", &ST7789_TFT::drawPixel, py::arg("x"), py::arg("y"), py::arg("color"), "Draw single pixel")
        .def("drawLine", &ST7789_TFT::drawLine, py::arg("x0"), py::arg("y0"), py::arg("x1"), py::arg("y1"), py::arg("color"), "Draw line")
        .def("drawRect", &ST7789_TFT::drawRect, py::arg("x"), py::arg("y"), py::arg("w"), py::arg("h"), py::arg("color"), "Draw rectangle outline")
        .def("fillRect", &ST7789_TFT::fillRect, py::arg("x"), py::arg("y"), py::arg("w"), py::arg("h"), py::arg("color"), "Fill rectangle")
        .def("drawCircle", &ST7789_TFT::drawCircle, py::arg("x"), py::arg("y"), py::arg("r"), py::arg("color"), "Draw circle outline (if implemented)")

        // Text & Font
        .def("setFont", &ST7789_TFT::setFont, py::arg("font_number"), "Select font (1-? depending on fonts included)")
        .def("print", py::overload_cast<const char*, int16_t, int16_t>(&ST7789_TFT::print), py::arg("text"), py::arg("x"), py::arg("y"), "Print text at position")

        // Bitmap (adjust if overloads differ)
        .def("drawBitmap", &ST7789_TFT::drawBitmap, py::arg("x"), py::arg("y"), py::arg("bitmap"), py::arg("w"), py::arg("h"), py::arg("color"), "Draw 1-bit bitmap")

        // Display control
        .def("setRotation", &ST7789_TFT::setRotation, py::arg("rotation"), "Set rotation 0-3")
        .def("invertDisplay", &ST7789_TFT::invertDisplay, py::arg("invert"), "Invert colors")
        .def("sleep", &ST7789_TFT::sleep, py::arg("enable"), "Sleep mode on/off")
        // .def("scroll", &ST7789_TFT::scroll, py::arg("offset"), "Vertical scroll if supported")

        ;

    // Enum for rotation (adjust type if header uses uint8_t or enum)
    py::enum_<uint8_t>(m, "Rotation")
        .value("DEG0", 0)
        .value("DEG90", 1)
        .value("DEG180", 2)
        .value("DEG270", 3)
        .export_values();
}
